# VERSE Backend — Environment Variables
# Copy this file to .env and fill in real values, or export them in your shell.
#
# Quick start (dev — no email, no watsonx):
#   uvicorn main:app --reload --port 8000
#
# Quick start (with IBM Granite AI):
#   export WATSONX_API_KEY=<your-ibm-cloud-api-key>
#   export WATSONX_PROJECT_ID=<your-watsonx-project-id>
#   export WATSONX_URL=https://us-south.ml.cloud.ibm.com
#   pip install ibm-watsonx-ai
#   uvicorn main:app --reload --port 8000

# ─── IBM watsonx / Granite ────────────────────────────────────────────────────
# Required to activate:
#   - Granite-based screenplay extraction  (upload.py → _granite_extract)
#   - LLM assumption trigger classification (reasoning/assumptions.py)
#   - Natural-language explanations         (reporting/explanations.py)
#   - Natural-language fix suggestions      (reporting/suggestions.py)
#   - Granite embedding entity matching     (services/watsonx.py → create_semantic_matcher)
#
# When unset all five features degrade silently to their rule-based fallbacks.
# Reports are still complete and accurate — just less fluent.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Model used for text generation (explanations, suggestions, screenplay extraction)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Model used for embeddings (entity matching — "Elena" == "Elena Chen")
WATSONX_EMBED_MODEL_ID=ibm/slate-125m-english-rtrvr

# ─── Upstream VERSE services (optional) ───────────────────────────────────────
# The ingestion pipeline calls these when set, and falls back when they are not.
#
# SCRIPT_SERVICE_URL — team 1's Script Intelligence API (script-intelligence/).
#   Preferred screenplay extractor: it returns wardrobe, prop ownership,
#   lighting and continuity notes, which the local fallbacks do not.
#   Also required by POST /upload/call-sheet.
#     cd script-intelligence && uvicorn app.main:app --port 8100
#   Unset → falls back to watsonx Granite, then to the heuristic regex parser.
SCRIPT_SERVICE_URL=

# VISION_SERVICE_URL — team 2's footage processing API (vision_pipeline/).
#   Lets POST /upload/footage accept a video clip instead of only the
#   scene_<id>.json the vision CLI writes.
#     cd vision_pipeline && uvicorn service:app --port 8200
#   Unset → video uploads return 503; JSON footage uploads still work.
VISION_SERVICE_URL=

# Timeout for both upstream calls, in seconds. Vision processing of a long clip
# is the slow one.
UPSTREAM_TIMEOUT_SECONDS=120

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Change this before deploying. A random 32-byte hex string is fine:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=verse-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ─── SMTP / Gmail (optional — OTP tokens are returned in JSON responses without this) ─
# Set these to deliver real OTP emails for password-reset and email-verification.
#
# ── Gmail (recommended) ──────────────────────────────────────────────────────
# 1. Enable 2-Step Verification on your Google account.
# 2. Create an App Password:
#      Google Account → Security → 2-Step Verification → App Passwords
#      App: Mail  |  Device: Other (Custom name, e.g. "VERSE")
#      Copy the 16-character password shown.
# 3. Fill in the vars below and restart the server.
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop     ← 16-char App Password (no spaces needed)
# SMTP_FROM=you@gmail.com
#
# ── Generic STARTTLS (Office 365, SendGrid, Mailgun, etc.) ────────────────────
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USE_SSL=false
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=yourpassword
# SMTP_FROM=noreply@yourdomain.com
#
# ── Active values (uncomment and fill in) ─────────────────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins beyond the defaults.
# Defaults already include http://localhost:5173 and http://localhost:4173.
# Example: CORS_ORIGINS=https://verse.yourdomain.com
CORS_ORIGINS=

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite by default (verse.db in the continuity-engine/ directory).
# For production, reimplement app/graph/storage.FactStore with Postgres.
# No env var needed for SQLite — path is hardcoded relative to main.py.
