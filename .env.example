# VERSE – Continuity Script Intelligence
# Environment variable template — safe to commit.
# Copy this file to .env and fill in your real values.
# Never commit the .env file itself.

# Local IBM Granite 4.1 inference server base URL (vLLM, Ollama, or OpenAI-compatible server)
GRANITE_BASE_URL=http://localhost:8000/v1

# Local IBM Granite 4.1 model identifier
GRANITE_MODEL=ibm-granite/granite-4.1
