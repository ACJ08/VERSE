# VERSE – Frontend Environment Variables
# Environment variable template — safe to commit.
# Copy this file to .env.local and fill in your real values.
# Never commit the .env.local file itself.

# ─── Continuity Engine (FastAPI backend) ─────────────────────────────────────
# Base URL of the VERSE continuity-engine / auth backend.
# Default (same-origin): leave empty when Vite dev-server proxies /auth /projects etc.
# Example for a separate backend process: VITE_API_URL=http://localhost:8000
VITE_API_URL=

# ─── Script Intelligence Microservice ────────────────────────────────────────
# Base URL of the script-intelligence FastAPI service.
# Used by scriptIntelligence.* API calls (parse, analyse, analyse-and-ingest).
# When unset, falls back to same-origin (empty string).
# Example: VITE_SCRIPT_API_URL=http://localhost:8001
VITE_SCRIPT_API_URL=
